<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml (android:dataExtractionRules).
     Device-to-device transfer is excluded for the same reason as cloud backup:
     the Keystore key that decrypts this file is non-exportable, so the copy
     that arrives on the new device is unopenable. See backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
